{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naqaa-field-lab-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "assets": {
    "directory": "../",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naqaa-field-lab-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "PAYMENTS_ENABLED": "0"
  }
}
